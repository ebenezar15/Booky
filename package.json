  "type": "module",
  "private": true,
  "productName": "Booky",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.ebenezar.booky",
    "productName": "Booky",
    "copyright": "Copyright © 2026 Ebenezar",
    "directories": {
      "output": "release/desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/index.html",
      "build/icon.ico",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "booky",
        "name": "Booky Book",
        "description": "Booky book backup",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "bookyreview",
        "name": "Booky Review Comments",
        "description": "Reviewer comments for a Booky book",
        "role": "Viewer",
        "icon": "build/icon"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Booky uses the microphone only while you use voice typing."
      }
    },
    "dmg": {
      "title": "Booky",
      "artifactName": "Booky-${version}-mac-${arch}.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Booky",
      "artifactName": "Booky-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Booky-${version}-portable.exe"
    },
    "afterPack": "desktop/after-pack.cjs"
  }
}
