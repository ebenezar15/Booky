  "description": "Booky — an offline book writing, formatting and publishing studio",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-fonts.mjs && vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "fonts": "node scripts/gen-fonts.mjs",
    "test": "node --test tests/*.test.js",
    "predev": "node scripts/gen-fonts.mjs",
    "release": "npm run build && node -e \"require('fs').mkdirSync('release',{recursive:true});require('fs').copyFileSync('dist/Booky.html','release/Booky.html')\""
  },
