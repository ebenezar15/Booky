{
  "name": "booky",
  "version": "2.0.0",
  "description": "Write, format and publish books — offline book writing studio.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-fonts.mjs && vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "fonts": "node scripts/gen-fonts.mjs",
    "test": "node --test tests/*.test.js",
    "predev": "node scripts/gen-fonts.mjs",
    "release": "npm run build && node -e \"const f=require('fs');f.mkdirSync('release',{recursive:true});f.copyFileSync('dist/Booky.html','release/Booky.html');f.copyFileSync('dist/review.html','review.html')\"",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "icons": "node scripts/gen-app-icons.cjs",
    "test:epub": "node scripts/epub-fixtures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebenezar15/Booky.git"
